# A first Pip-OS ROM. Copy this folder to start your own, then set
# PIPOS_SDK to the sdk/ folder of your Pip-OS checkout.
PIPOS_SDK ?= ../..
IMAGE     := ROM1.ROM
KIND      := rom
NAME      := HELLO
TITLE     := Hello from the SDK
VERSION   := 1.0.0
SRCS      := main.c
include $(PIPOS_SDK)/pipos-app.mk
